{
  "$schema": "https://popcorn-ai.local/design/tokens.schema.json",
  "meta": {
    "name": "Popcorn AI Design System — Cinema at Home",
    "version": "1.0.0",
    "targets": ["apps/alexa-web", "apps/tv"]
  },
  "color": {
    "bg": {
      "canvas": "#0D0A08",
      "primary": "#0D0A08",
      "elevated": "#16110E",
      "surface": "#1F1814",
      "surfaceHover": "#2A201A",
      "surfaceActive": "#342820",
      "glass": "rgba(31, 24, 20, 0.78)",
      "spotlight": "rgba(245, 185, 66, 0.08)"
    },
    "text": {
      "primary": "#FAF3E8",
      "secondary": "#D1C2B0",
      "muted": "#9E8C78",
      "onAccent": "#140E09"
    },
    "accent": {
      "popcorn": "#F5B942",
      "popcornHover": "#FFCA5C",
      "amber": "#E8882D",
      "ember": "#D95B26",
      "cream": "#FFF1D0"
    },
    "border": {
      "subtle": "#2C221C",
      "default": "#3D2F26",
      "strong": "#574336",
      "accent": "rgba(245, 185, 66, 0.45)"
    },
    "status": {
      "success": "#72C47A",
      "successBg": "rgba(114, 196, 122, 0.14)",
      "warning": "#F5B942",
      "warningBg": "rgba(245, 185, 66, 0.14)",
      "error": "#E56B55",
      "errorBg": "rgba(229, 107, 85, 0.16)",
      "kidBadge": "#E8993E",
      "kidBadgeBg": "rgba(232, 153, 62, 0.18)"
    },
    "orb": {
      "idle": {
        "core": "#2B211B",
        "ring": "#6E5239",
        "glow": "rgba(245, 185, 66, 0.14)"
      },
      "listening": {
        "core": "#F5B942",
        "ring": "#FFE299",
        "glow": "rgba(245, 185, 66, 0.48)"
      },
      "thinking": {
        "core": "#E8882D",
        "ring": "#F5B942",
        "glow": "rgba(232, 136, 45, 0.38)"
      },
      "speaking": {
        "core": "#FFF1D0",
        "ring": "#F5B942",
        "glow": "rgba(255, 241, 208, 0.44)"
      },
      "error": {
        "core": "#C84B31",
        "ring": "#E56B55",
        "glow": "rgba(229, 107, 85, 0.42)"
      }
    },
    "avatar": [
      "#C85A32",
      "#B87D28",
      "#8E4A49",
      "#5C7A52",
      "#9E6240",
      "#7A5475",
      "#A8423F",
      "#6F6A42"
    ]
  },
  "typography": {
    "fontFamily": {
      "display": "Fraunces",
      "sans": "Plus Jakarta Sans"
    },
    "fontSize": {
      "xs": 12,
      "sm": 14,
      "md": 16,
      "lg": 18,
      "xl": 22,
      "2xl": 28,
      "3xl": 36,
      "4xl": 48
    },
    "lineHeight": {
      "tight": 1.15,
      "snug": 1.3,
      "normal": 1.5,
      "relaxed": 1.65
    },
    "fontWeight": {
      "regular": "400",
      "medium": "500",
      "semibold": "600",
      "bold": "700"
    }
  },
  "spacing": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 20,
    "6": 24,
    "8": 32,
    "10": 40,
    "12": 48,
    "16": 64
  },
  "radius": {
    "xs": 6,
    "sm": 10,
    "md": 14,
    "lg": 20,
    "xl": 28,
    "full": 9999
  },
  "shadows": {
    "sm": "0 2px 8px rgba(0, 0, 0, 0.45)",
    "md": "0 8px 24px rgba(0, 0, 0, 0.55)",
    "lg": "0 16px 40px rgba(0, 0, 0, 0.68)",
    "focusRing": "0 0 0 3px rgba(245, 185, 66, 0.65)"
  },
  "motion": {
    "durationMs": {
      "fast": 140,
      "normal": 240,
      "slow": 420,
      "pulse": 2200,
      "orbit": 3200
    },
    "easing": {
      "out": "cubic-bezier(0.16, 1, 0.3, 1)",
      "inOut": "cubic-bezier(0.65, 0, 0.35, 1)",
      "spring": "cubic-bezier(0.34, 1.56, 0.64, 1)"
    }
  }
}
